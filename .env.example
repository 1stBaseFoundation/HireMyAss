# ---------------------------------------------------------------------------
# App-side config. Model *files* are NOT configured here — llama-server is
# launched by scripts/preflight.mjs and scripts/servers.ps1, which own the
# .gguf paths. The app only ever speaks HTTP to these endpoints.
#
# Copy to .env.local and adjust if your ports or hardware change.
# ---------------------------------------------------------------------------

# ---- coordinator: chat -> filters, resume -> JSON (GPU 0, port 8081) ----
COORDINATOR_URL=http://127.0.0.1:8081
COORDINATOR_LABEL=qwen3.5-4b

# ---- vision / OCR for scanned PDFs (GPU 1, port 8082) ----
VISION_URL=http://127.0.0.1:8082
VISION_LABEL=qwen2.5-omni-7b

# ---- storage ----
DATA_DIR=K:\HireMyAss\data

# ---- timeouts (ms) ----
LLM_CHAT_TIMEOUT_MS=120000
LLM_VISION_TIMEOUT_MS=240000
LLM_HEALTH_TIMEOUT_MS=3000
SOURCE_TIMEOUT_MS=15000

# ---- ranking ----
SCORE_TITLE_MULTIPLIER=3
SCORE_RECENCY_HALF_LIFE=7
